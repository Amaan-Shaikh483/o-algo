# Ignore all custom chart indicators added by the user
*.js

# But keep this .gitignore and the folder README
!.gitignore
!README.md

# Open Range Breakout ships with OpenAlgo as a working reference indicator, so
# a fresh install has one real example to read and modify.
!open_range_breakout.js

# Auto-trade indicators ship with OpenAlgo as ready-to-use examples
!auto-macd.js
!auto-supertrend.js
!auto-ema-cross.js
!autoTradeIndicator.js
!pivot-points-strategy.js

# Ignore backup and editor files
*.bak
*.backup
*~

# Keep the directory but ignore its contents beyond the exceptions above.
